<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {%- for p in site.pages %}
    {%- unless p.redirect_to or p.url == "/404.html" or p.url contains "/tag/" %}
  <url>
    <loc>{{ p.url | absolute_url }}</loc>
  </url>
    {%- endunless %}
  {%- endfor %}
</urlset>
